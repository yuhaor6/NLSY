# Python virtual environment
.venv/

# Claude local memory
.claude/

# Binary Stata datasets (large, not version-controlled)
data/*.dta
data/*.raw

# Raw NLSY data files (proprietary)
data/*.NLSY79
data/*.cdb
data/*.dat
data/*.sas
data/*.sps

# Intermediate/temporary Stata files in data/
data/base_data.dta
data/*_temp*.dta
data/cpi_*.dta
data/counterfactual_*.dta
data/paired_*.dta
data/taxsim_*.dta
data/predicted_rates*.dta
data/nlsy_*.dta
data/gruber_saez_regression_data.dta
data/merged_data*.dta
data/occ_ind*.dta
data/eda_deepdive_data.dta
data/analysis_*.dta
data/bsx_wave_analysis.dta
data/wages_by_age.png
data/wages_by_cumhrs_bars.png
data/wages_by_experience.png
data/wages_by_work_intensity.png
data/wages_cumhrs_scatter.png

# Temporary diagnostic do files in data/
data/check_vars*.do
data/check_vars*.log
data/diag_cwd*.do
data/diag_cwd*.log
data/test_if_syntax*.do
data/test_if_syntax*.log
data/test_run*.do
data/test_run*.log
data/verify*.do
data/verify*.log

# Root-level Stata log files (auto-generated, not source code)
*.log

# Output binary figures (regenerated by do files)
output/*.png

# Output binary Stata datasets
output/*.dta
output/*.raw

# Large presentation artifacts
lab_meeting_presentation.html

# Python build artifacts
__pycache__/
*.pyc
*.pyo
